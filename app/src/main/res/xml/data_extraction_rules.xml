<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   The housing database is the app's only data, so it is backed up and transferred (ADR-0001).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
